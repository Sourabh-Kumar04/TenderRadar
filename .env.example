# ==========================================
# TenderRadar Configuration Environment Variables
# ==========================================

# Search Provider Selection (serpapi | reserp, default: serpapi)
# SerpApi is primary for hackathon evaluation; Reserp acts as secondary fallback.
SEARCH_PROVIDER=serpapi

# SerpApi Credentials (Sign up at https://serpapi.com)
# Free tier provides 250 credits/month. TenderRadar optimizes credit usage
# with query caching and tight search filters.
SERPAPI_API_KEY=your_serpapi_api_key_here

# Reserp Credentials & Configuration (Sign up at https://reserp.ai)
# Reserp v2 API provides 5,000 free requests/month with full India geotargeting.
RESERP_API_KEY=your_reserp_api_key_here
RESERP_BASE_URL=https://api.reserp.ai

# Fireworks AI Summarizer Configuration (OpenAI-compatible)
# Powered by DeepSeek V4P1 Flash for fast, structured bid analysis
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_MODEL=accounts/fireworks/models/deepseek-v4p1-flash

# Legacy / Generic LLM Key and URL fallback (optional aliases)
LLM_API_KEY=your_fireworks_api_key_here
LLM_BASE_URL=https://api.fireworks.ai/inference/v1

# Offline / Mock flags (set to 1 or true for local demo / tests without API keys)
MOCK_SERPAPI=0
MOCK_LLM=0

# Application Settings
DATABASE_PATH=data/tenders.db
SCAN_SCHEDULE_HOUR=6
SCAN_SCHEDULE_MINUTE=0
CACHE_TTL_HOURS=24
PORT=8000
HOST=0.0.0.0
DEBUG=False
